<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5FC">


    <TextView
        android:id="@+id/tvResetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Reset Password"
        android:textColor="#3559B8"
        android:textSize="30sp"
        android:textStyle="bold"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="130dp"/>


    <TextView
        android:id="@+id/tvResetDesc"
        android:layout_width="280dp"
        android:layout_height="wrap_content"

        android:text="Create your new password to secure your account"

        android:textColor="#8A99A8"
        android:textSize="13sp"
        android:gravity="center"

        app:layout_constraintTop_toBottomOf="@id/tvResetTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="10dp"/>



    <EditText
        android:id="@+id/etNewPassword"

        android:layout_width="0dp"
        android:layout_height="50dp"

        android:hint="New password"
        android:inputType="textPassword"

        android:textSize="15sp"

        android:paddingStart="15dp"

        android:background="@drawable/edittext_bg"

        app:layout_constraintTop_toBottomOf="@id/tvResetDesc"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"

        android:layout_marginTop="40dp"/>




    <EditText
        android:id="@+id/etConfirmPassword"

        android:layout_width="0dp"
        android:layout_height="50dp"

        android:hint="Confirm password"

        android:inputType="textPassword"

        android:textSize="15sp"

        android:paddingStart="15dp"

        android:background="@drawable/edittext_bg"


        app:layout_constraintTop_toBottomOf="@id/etNewPassword"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"

        android:layout_marginTop="15dp"/>




    <com.google.android.material.button.MaterialButton

        android:id="@+id/btnUpdatePassword"

        android:layout_width="0dp"
        android:layout_height="50dp"

        android:text="Update Password"

        android:textAllCaps="false"

        android:textColor="#FFFFFF"

        android:textSize="16sp"

        android:backgroundTint="#3559B8"

        app:cornerRadius="12dp"


        app:layout_constraintTop_toBottomOf="@id/etConfirmPassword"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"


        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"

        android:layout_marginTop="80dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>
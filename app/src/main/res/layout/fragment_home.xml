<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF5FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="50dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/txtWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Hi, Welcome!"
            android:textColor="#3158B8"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:text="What would you like to do today?"
            android:textColor="#7A8A9E"
            android:textSize="15sp" />

        <!-- BUY AIRCOND CARD -->
        <LinearLayout
            android:id="@+id/cardBuy"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="35dp"
            android:background="@drawable/card_background"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:padding="18dp">

            <ImageView
                android:id="@+id/imgBuy"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="#EAF2FF"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_aircond" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buy Aircond"
                    android:textColor="#3158B8"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Browse and purchase air conditioners"
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- MAINTENANCE CARD -->
        <LinearLayout
            android:id="@+id/cardMaintenance"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_background"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:padding="18dp">

            <ImageView
                android:id="@+id/imgMaintenance"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="#EAF2FF"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_maintenance" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aircond Maintenance"
                    android:textColor="#3158B8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Book aircond servicing"
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- BTU CALCULATOR CARD -->
        <LinearLayout
            android:id="@+id/cardCalculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_background"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Card Header -->
            <LinearLayout
                android:id="@+id/headerCalculator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgCalculator"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:background="#EAF2FF"
                    android:contentDescription="@null"
                    android:padding="14dp"
                    android:src="@drawable/ic_aircond" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BTU Aircond Calculator"
                        android:textColor="#3158B8"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Calculate recommended HP"
                        android:textColor="#8A97A8"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Inline Calculator Form -->
            <LinearLayout
                android:id="@+id/layoutCalculatorForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="16dp"
                    android:background="#EAF2FF" />

                <!-- Room Length & Width Inputs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Room Length -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Length (ft)"
                            android:textColor="#3158B8"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etRoomLength"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_grey"
                            android:hint="e.g. 12"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="12dp"
                            android:textColor="#2D3748"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Room Width -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Width (ft)"
                            android:textColor="#3158B8"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etRoomWidth"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_grey"
                            android:hint="e.g. 15"
                            android:imeOptions="actionDone"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="12dp"
                            android:textColor="#2D3748"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Room Type Selection Dropdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Room Type / Environment"
                    android:textColor="#3158B8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerRoomType"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_grey"
                    android:paddingHorizontal="12dp" />

                <!-- Calculate Button -->
                <Button
                    android:id="@+id/btnCalculateBtu"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#3158B8"
                    android:text="Calculate BTU &amp; HP"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Result Box -->
                <LinearLayout
                    android:id="@+id/layoutBtuResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#F0F5FF"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtRoomArea"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Room Area: -"
                        android:textColor="#2D3748"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtRequiredBtu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Required BTU: -"
                        android:textColor="#2D3748"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtRecommendedHp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Recommended: -"
                        android:textColor="#3158B8"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>

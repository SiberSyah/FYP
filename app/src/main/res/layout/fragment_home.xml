<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF5FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="50dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/txtWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Hi, Welcome!"
            android:textColor="#3158B8"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:text="What would you like to do today?"
            android:textColor="#7A8A9E"
            android:textSize="15sp" />

        <!-- BUY AIRCOND CARD -->
        <LinearLayout
            android:id="@+id/cardBuy"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="35dp"
            android:background="@drawable/card_background"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:padding="18dp">

            <ImageView
                android:id="@+id/imgBuy"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="#EAF2FF"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_aircond" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buy Aircond"
                    android:textColor="#3158B8"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Browse and purchase air conditioners"
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- MAINTENANCE CARD -->
        <LinearLayout
            android:id="@+id/cardMaintenance"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_background"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:padding="18dp">

            <ImageView
                android:id="@+id/imgMaintenance"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="#EAF2FF"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_maintenance" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aircond Maintenance"
                    android:textColor="#3158B8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Book aircond servicing"
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3E3EF">


    <!-- Logo -->
    <ImageView
        android:id="@+id/imgAdminLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/yusrilogo"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_logo"
        android:clipToOutline="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp"/>


    <!-- Title -->
    <TextView
        android:id="@+id/tvAdminTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADMIN LOGIN"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#3158B8"
        app:layout_constraintTop_toBottomOf="@id/imgAdminLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp"/>


    <!-- Email -->

    <EditText
        android:id="@+id/etAdminEmail"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Email"
        android:background="@drawable/bg_input_field"
        android:padding="15dp"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/tvAdminTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="35dp"/>


    <!-- Password -->

    <EditText
        android:id="@+id/etAdminPassword"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Password"
        android:background="@drawable/bg_input_field"
        android:padding="15dp"
        android:inputType="textPassword"
        app:layout_constraintTop_toBottomOf="@id/etAdminEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"/>


    <!-- Button -->

    <Button
        android:id="@+id/btnAdminLogin"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Login"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="#3158B8"
        app:layout_constraintTop_toBottomOf="@id/etAdminPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="30dp"/>


    <!-- Back -->

    <TextView
        android:id="@+id/tvBackLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back to User Login"
        android:textColor="#3158B8"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/btnAdminLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8EDF5"
    android:padding="16dp">

    <!-- Tajuk Atas -->
    <TextView
        android:id="@+id/tvOrderSummaryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Order Summary"
        android:textColor="#2D5284"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Kad Utama (Card Container) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOrderDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOrderSummaryTitle"
        app:layout_constraintBottom_toTopOf="@id/btnPayNow">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Tajuk Produk -->
                <TextView
                    android:id="@+id/tvProductDetailsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product Details"
                    android:textColor="#3A5C8E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Bahagian Info Produk (Gambar + Teks) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgProduct"
                        android:layout_width="70dp"
                        android:layout_height="60dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@android:drawable/ic_menu_gallery"
                        tools:src="@tools:sample/backgrounds/scenic" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProductName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#2D5284"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="UltraCool 12,000 BTU Air Conditioner" />

                        <TextView
                            android:id="@+id/tvProductFeature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#557297"
                            android:textSize="12sp"
                            tools:text="• Cooling &amp; Heating" />

                        <TextView
                            android:id="@+id/tvProductModel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#557297"
                            android:textSize="12sp"
                            tools:text="• Model: UC-12000" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Garis Pemisah 1 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#D1DBE8" />

                <!-- Status Pemasangan (Installation / Unit Only) -->
                <LinearLayout
                    android:id="@+id/layoutInstallationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgCheckIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@android:drawable/checkbox_on_background" />

                    <TextView
                        android:id="@+id/tvInstallationTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#2D5284"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Installation :" />

                    <TextView
                        android:id="@+id/tvInstallationDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="#557297"
                        android:textSize="12sp"
                        tools:text="Professional installation Included" />
                </LinearLayout>

                <!-- Garis Pemisah (Booking Info) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#D1DBE8" />

                <!-- Tajuk Booking Info -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking Info"
                    android:textColor="#3A5C8E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Booking Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Date"
                        android:textColor="#557297"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvBookingDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2D5284"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="30 Jul 2026" />
                </LinearLayout>

                <!-- Booking Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Time"
                        android:textColor="#557297"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvBookingTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2D5284"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="2:00 PM" />
                </LinearLayout>

                <!-- Garis Pemisah (Customer Info) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#D1DBE8" />

                <!-- Tajuk Customer Info -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer"
                    android:textColor="#3A5C8E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Customer Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Name"
                        android:textColor="#557297"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCustomerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2D5284"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Adam" />
                </LinearLayout>

                <!-- Customer Phone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phone"
                        android:textColor="#557297"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCustomerPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2D5284"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="012-3456789" />
                </LinearLayout>

                <!-- Customer Address -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Address"
                        android:textColor="#557297"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCustomerAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#2D5284"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="123 Jalan ABC, 12345 Kuah, Kedah" />
                </LinearLayout>

                <!-- Garis Pemisah (Price Info) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#D1DBE8" />

                <!-- Harga Air Conditioner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Air Conditioner"
                        android:textColor="#557297"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvAirCondPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2D5284"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="RM 2,000" />
                </LinearLayout>

                <!-- Row Harga Installation (Boleh disembunyikan jika 'Unit Only') -->
                <LinearLayout
                    android:id="@+id/rowInstallationFee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Installation Fee"
                        android:textColor="#557297"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvInstallationPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2D5284"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="RM 350" />
                </LinearLayout>

                <!-- Garis Pemisah 2 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#D1DBE8" />

                <!-- Total Price -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="RM 2,350" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.cardview.widget.CardView>

    <!-- Butang Pay Now -->
    <Button
        android:id="@+id/btnPayNow"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#1D5CAB"
        android:text="Pay Now"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Navigation Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigationCard"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="30dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnNavProfile"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/ic_person" />

            <ImageView
                android:id="@+id/btnNavHome"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/ic_home" />

            <ImageView
                android:id="@+id/btnNavOrders"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/ic_orders" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
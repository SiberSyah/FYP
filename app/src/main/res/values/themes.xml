<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Base.Theme.EncikAircond" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here -->
    </style>

    <style name="Theme.EncikAircond" parent="Base.Theme.EncikAircond" />

    <!-- Stripe Card Field Theme -->
    <style name="StripeCardTheme" parent="ThemeOverlay.Material3">
        <item name="colorControlNormal">#9AA5B5</item>
        <item name="colorControlActivated">#1565C0</item>
        <item name="colorPrimary">#1565C0</item>
        <item name="android:textColor">#17213A</item>
        <item name="android:textColorHint">#9AA5B5</item>
    </style>

    <!-- Calendar Styles -->
    <style name="CalendarDate">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CalendarWeekDay">
        <item name="android:textColor">#000000</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalendarTheme" parent="ThemeOverlay.AppCompat">
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="android:textColor">#000000</item>
    </style>

</resources>
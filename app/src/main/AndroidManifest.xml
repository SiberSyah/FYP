<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EncikAircond">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Select Aircond -->
        <activity
            android:name=".activities.SelectAircondActivity"
            android:exported="false" />

        <!-- Add Address -->
        <activity
            android:name=".activities.AddAddressActivity"
            android:exported="false" />

        <!-- Buy Summary -->
        <activity
            android:name=".activities.BuySummaryActivity"
            android:exported="false" />

        <!-- Payment Method -->
        <activity
            android:name=".activities.PaymentMethodActivity"
            android:exported="false" />

        <!-- Stripe Payment -->
        <activity
            android:name=".activities.StripePaymentActivity"
            android:exported="false" />

        <!-- Add Payment -->
        <activity
            android:name=".activities.AddPaymentActivity"
            android:exported="false" />

        <!-- Payment Success -->
        <activity
            android:name=".activities.PaymentSuccessActivity"
            android:exported="false" />

        <!-- Maintenance Flow -->
        <activity
            android:name=".activities.MaintenanceActivity"
            android:exported="false" />
        <activity
            android:name=".activities.MaintenanceDateActivity"
            android:exported="false" />

        <!-- Order Flow -->
        <activity
            android:name=".activities.OrderStatusActivity"
            android:exported="false" />

        <!-- Address Management -->
        <activity
            android:name=".activities.AddressActivity"
            android:exported="false" />

        <!-- Auth and Others -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".activities.WelcomeActivity"
            android:exported="false" />

    </application>

</manifest>